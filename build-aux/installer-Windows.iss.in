;
;
;
;
;
;

#define AppName "SceneAnchor"
#define AppVersion "@CMAKE_PROJECT_VERSION@"
#define ModuleName "@CMAKE_PROJECT_NAME@"
#define AppGuid "C459A50D-D80F-461D-8A3B-4854C1CA7A11"

#ifndef PackageDir
  #define PackageDir "@CMAKE_CURRENT_SOURCE_DIR@\release\Package"
#endif

[Setup]
AppId={{{#AppGuid}}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
VersionInfoVersion={#AppVersion}
AppPublisher=rockbenben
AppPublisherURL=https://github.com/rockbenben/scene-anchor
AppSupportURL=https://github.com/rockbenben/scene-anchor/issues
AppUpdatesURL=https://github.com/rockbenben/scene-anchor/releases
DefaultDirName={code:GetDirName}
AppendDefaultDirName=no
DisableDirPage=no
DirExistsWarning=no
UsePreviousAppDir=no
DisableProgramGroupPage=yes
PrivilegesRequired=admin
ArchitecturesAllowed=x64compatible
LicenseFile=@CMAKE_CURRENT_SOURCE_DIR@\LICENSE
OutputBaseFilename={#ModuleName}-{#AppVersion}-windows-x64-Installer
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
UninstallDisplayName={#AppName} (OBS plugin)

[Languages]
Name: "en"; MessagesFile: "compiler:Default.isl"

[Files]
Source: "{#PackageDir}\recommended\*"; DestDir: "{app}"; Excludes: "*.pdb"; \
    Flags: ignoreversion recursesubdirs createallsubdirs; Check: IsRecommendedLayout
Source: "{#PackageDir}\portable\*"; DestDir: "{app}"; Excludes: "*.pdb"; \
    Flags: ignoreversion recursesubdirs createallsubdirs; Check: IsLegacyLayout

[Messages]
en.FinishedLabel=Setup has installed [name] on your computer.%n%nThe dock is hidden until you turn it on: start OBS Studio and tick View -> Docks -> SceneAnchor.

[Code]
const
  UninstallKey = 'SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{' + '{#AppGuid}' + '}_is1';

function IsUnderProgramData(Path: string): Boolean;
begin
  Result := Pos(LowerCase(ExpandConstant('{commonappdata}')), LowerCase(Path)) = 1;
end;

function IsRecommendedLayout(): Boolean;
begin
  Result := IsUnderProgramData(WizardDirValue());
end;

function IsLegacyLayout(): Boolean;
begin
  Result := not IsRecommendedLayout();
end;

function GetDirName(Value: string): string;
var
  PrevPath: string;
begin
  Result := ExpandConstant('{commonappdata}\obs-studio\plugins');
  if RegQueryStringValue(HKLM, UninstallKey, 'InstallLocation', PrevPath) and (PrevPath <> '') then
    Result := RemoveBackslashUnlessRoot(PrevPath);
end;

function NextButtonClick(CurPageID: Integer): Boolean;
var
  Dir: string;
begin
  Result := True;
  if CurPageID <> wpSelectDir then
    Exit;

  Dir := RemoveBackslashUnlessRoot(WizardDirValue());
  if IsUnderProgramData(Dir) then begin
    if CompareText(ExtractFileName(Dir), 'plugins') <> 0 then begin
      MsgBox('Under ProgramData the target must be the OBS plugins folder itself,'
             + #13#10 + 'e.g. ' + ExpandConstant('{commonappdata}\obs-studio\plugins') + #13#10#13#10
             + 'The {#ModuleName} folder is created inside it for you.', mbError, MB_OK);
      Result := False;
    end;
  end else begin
    if not DirExists(Dir + '\obs-plugins\64bit') then begin
      MsgBox('No obs-plugins\64bit folder here, so this is not an OBS installation.'
             + #13#10 + 'Pick the OBS Studio root folder (portable or installed),' + #13#10
             + 'or install to ' + ExpandConstant('{commonappdata}\obs-studio\plugins') + ' instead.',
             mbError, MB_OK);
      Result := False;
    end;
  end;
end;

procedure RemoveStaleInstall();
var
  OldPath: string;
begin
  if not RegQueryStringValue(HKLM, UninstallKey, 'InstallLocation', OldPath) then
    Exit;
  if OldPath = '' then
    Exit;
  OldPath := RemoveBackslashUnlessRoot(OldPath);
  if IsUnderProgramData(OldPath) = IsRecommendedLayout() then
    Exit;

  if IsUnderProgramData(OldPath) then begin
    DelTree(OldPath + '\{#ModuleName}', True, True, True);
  end else begin
    DeleteFile(OldPath + '\obs-plugins\64bit\{#ModuleName}.dll');
    DeleteFile(OldPath + '\obs-plugins\64bit\{#ModuleName}.pdb');
    DelTree(OldPath + '\data\obs-plugins\{#ModuleName}', True, True, True);
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssInstall then
    RemoveStaleInstall();
end;
